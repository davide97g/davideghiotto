# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://davideghiotto.it,https://www.davideghiotto.it

# Long random string — rotate in production
SESSION_SECRET=change-me-to-a-long-random-secret

# SQLite path (absolute on the VPS, relative is fine in dev)
DATABASE_PATH=./data/ral-gate.sqlite

# Resend — leave empty in dev to print OTP codes to the console
RESEND_API_KEY=
EMAIL_FROM="RAL Gate <ral@davideghiotto.it>"

# OTP
OTP_TTL_SECONDS=600
OTP_LENGTH=6

# How long a verified unlock can fetch RAL data (default 1 hour)
SESSION_TTL_SECONDS=3600
